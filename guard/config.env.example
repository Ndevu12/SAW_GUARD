# Environment contract for the guard summary renderer (the guard package)
#
# This is the single, documented interface between the action's steps (the producer) and the
# renderer (the consumer). In CI these variables are set by action.yml's step `env:` blocks and by
# the GitHub Actions runtime; the renderer reads them ONLY through guard.config.Config.from_env.
# Copy this file to `.env` and `set -a; . guard/.env; set +a`, then run
# `PYTHONPATH=. python3 -m guard` to drive the renderer locally against a real report.
#
# The variable NAMES here are mirrored one-to-one by the `_ENV` map in guard/config.py — keep the
# two in sync when adding a field.

# ── Report data (written by the "Run worm scan" step) ──────────────────────────────────────
# Preferred data source: the scanner's REDACTED report (evidence fingerprinted, not raw).
SAW_GUARD_REDACTED=/tmp/saw-guard-reports/latest.json
# Fallback only (older scanner without `-d`): the full-evidence report. Evidence is NEVER rendered.
SAW_GUARD_REPORT=/tmp/saw-guard-reports/report.json
# Where the shareable markdown body is written; the sticky-PR-comment step re-posts this file.
SAW_GUARD_SUMMARY_OUT=/tmp/saw-guard-reports/summary.md

# ── Verdict & counts (the scan step's outputs) ─────────────────────────────────────────────
SAW_GUARD_VERDICT=infected      # clean | suspicious | infected | (empty on an aborted scan)
SAW_GUARD_INFECTED=1
SAW_GUARD_SUSPICIOUS=0
SAW_GUARD_FINDINGS=2
SAW_GUARD_SCAN_RC=1             # saw scan exit code: 0 clean, 1 infected, 2 usage/aborted

# ── Guidance context ───────────────────────────────────────────────────────────────────────
SAW_GUARD_CONFIG_INPUT=config/security.yml   # the workflow's config-file input (shown in the repro command)
SAW_GUARD_PATCHES=false                       # "true" when saw fix wrote sab-patches/*.patch

# ── Provided by the GitHub Actions runtime (do not set by hand in CI) ──────────────────────
# GITHUB_STEP_SUMMARY=/path/to/step-summary.md   # the run-page summary the renderer appends to
